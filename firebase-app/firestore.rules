rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function ok() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['charly.valero@gmail.com', 'mireia.sastre79@gmail.com'];
    }
    // Tomas: se crean una vez; cada cambio (corrección o anulación) sube la versión en 1; nunca se borran.
    match /logs/{id} {
      allow read: if ok();
      allow create: if ok();
      allow update: if ok() && request.resource.data.version == resource.data.version + 1;
      allow delete: if false;
    }
    match /meds/{id} {
      allow read, create, update: if ok();
      allow delete: if false;
    }
    match /{col}/{id} {
      allow read, write: if ok() && col in ['inc', 'members', 'config'];
    }
  }
}
