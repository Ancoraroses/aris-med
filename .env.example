# Copia este archivo a .env.local y rellena los valores de TU proyecto Supabase.
# (Supabase → Project Settings → API)
# La "anon key" es pública por diseño: la seguridad real la dan las reglas RLS de la base de datos.
# NUNCA pongas aquí la service_role key ni contraseñas.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_CLAVE_ANON_PUBLICA

# Clave PÚBLICA VAPID para notificaciones push (se genera con: npx web-push generate-vapid-keys)
# Déjala vacía si de momento no activas push.
VITE_VAPID_PUBLIC_KEY=
