-- PROGRAMAR EL ENVÍO DE RECORDATORIOS (ejecútalo a mano en Supabase → SQL Editor, DESPUÉS de verificar las pautas).
-- Sustituye los dos valores marcados. NO subas este archivo relleno a ningún repositorio.
--
-- Requiere las extensiones pg_cron y pg_net (Supabase → Database → Extensions → activar ambas).

create extension if not exists pg_cron;
create extension if not exists pg_net;

select cron.schedule(
  'aris-med-reminders',
  '* * * * *',                       -- cada minuto
  $$
  select net.http_post(
    url     := 'https://TU-PROYECTO.supabase.co/functions/v1/send-reminders',   -- ← cambia
    headers := jsonb_build_object('Content-Type', 'application/json',
                                  'x-cron-secret', 'EL_MISMO_CRON_SECRET_QUE_PUSISTE_EN_supabase_secrets'),  -- ← cambia
    body    := '{}'::jsonb
  );
  $$
);

-- Para pararlo:   select cron.unschedule('aris-med-reminders');
-- Alternativa sin pg_cron: cualquier servicio de cron externo que haga un POST cada minuto a la misma URL
-- con la cabecera x-cron-secret.
